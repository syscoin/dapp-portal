# Manual Nuxt server deployment. Keep public build inputs identical to the reviewed release.
FROM node:26-alpine AS base
RUN node -e 'const [major, minor, patch] = process.versions.node.split(".").map(Number); if (major !== 26 || minor < 12 || (minor === 12 && patch < 1)) throw new Error("Node.js >=26.12.1 <27 is required");'

FROM base AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
ARG WALLET_CONNECT_PROJECT_ID
ARG PORTAL_URL
ARG GIT_REPO_URL
ARG GIT_COMMIT_HASH
ARG SENTRY_DSN
ARG SENTRY_ENV
ARG SCREENING_API_URL
ARG RUDDER_KEY
ARG DATAPLANE_URL
ARG ANKR_TOKEN
ENV WALLET_CONNECT_PROJECT_ID=$WALLET_CONNECT_PROJECT_ID \
    PORTAL_URL=$PORTAL_URL \
    GIT_REPO_URL=$GIT_REPO_URL \
    GIT_COMMIT_HASH=$GIT_COMMIT_HASH \
    SENTRY_DSN=$SENTRY_DSN \
    SENTRY_ENV=$SENTRY_ENV \
    SCREENING_API_URL=$SCREENING_API_URL \
    RUDDER_KEY=$RUDDER_KEY \
    DATAPLANE_URL=$DATAPLANE_URL \
    ANKR_TOKEN=$ANKR_TOKEN
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx nuxt build

FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=build /app/.output ./.output
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
